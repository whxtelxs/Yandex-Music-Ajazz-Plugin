{
  "name": "yandex-music-ajazz-plugin",
  "version": "2.1.0",
  "author": "whxtelxs",
  "main": "index.js",
  "description": "Yandex Music Controller for Ajazz AKP 153",
  "scripts": {
    "css:build": "tailwindcss -i ../propertyInspector/tailwind.input.css -o ../propertyInspector/utils/tailwind.css --minify && node scripts/clean-css.js",
    "postinstall": "node scripts/patch-discord-rpc.js",
    "prod": "npm run css:build && npm run ui:build && node package-prod.js",
    "test": "node scripts/test.js",
    "check": "node scripts/check.js",
    "release": "node scripts/release.js",
    "ui:build": "node scripts/build-panel.js",
    "dev": "node scripts/dev.js"
  },
  "license": "ISC",
  "dependencies": {
    "chrome-remote-interface": "^0.33.0",
    "discord-rpc": "4.0.1",
    "fs-extra": "^11.3.0",
    "log4js": "^6.9.1",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@tailwindcss/cli": "^4.3.2",
    "dompurify": "3.4.16",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "marked": "18.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.2"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@parcel/watcher": "2.6.0",
    "source-map-js": "1.2.2"
  }
